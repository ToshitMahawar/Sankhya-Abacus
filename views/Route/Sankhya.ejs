<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Payment Page</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: #f3f4f6;
    }

    .card-custom {
      border-radius: 15px;
      padding: 20px;
      background: white;
    }

    .left-card {
      background: #eef2ff;
      border-radius: 15px;
      padding: 20px;
    }

    .top-banner {
      background: #2563eb;
      color: white;
      padding: 20px;
      border-radius: 15px;
    }

    .course-img {
      width: 100%;
      border-radius: 10px;
    }

    .pay-btn {
      background: #2563eb;
      color: white;
      font-size: 18px;
      padding: 12px;
      border-radius: 10px;
      width: 100%;
      border: none;
    }

    .pay-btn:hover {
      background: #1d4ed8;
    }
  </style>
</head>

<body>

<div class="container mt-5">
  <div class="row g-4">

    <!-- LEFT SIDE -->
    <div class="col-md-5">
      <div class="left-card">

        <div class="top-banner text-center">
          <h4>Sankhya Abacus</h4>
        </div>

        <div class="mt-4">
          <!-- 🔥 YOUR IMAGE HERE -->
          <img src="toshit.jpeg" class="course-img">
        </div>

        <h5 class="mt-3">
          Sigma 11 – Data Structures & Web Development
        </h5>

        <p>Classes starting soon</p>

      </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="col-md-7">
      <div class="card-custom">

        <h5>Payment Details</h5>
        <p>Free</p>

        <form class="mt-4">

          <div class="mb-3">
            <label>Email</label>
            <input type="email" class="form-control" placeholder="Enter email">
          </div>

          <div class="mb-3">
            <label>Phone</label>
            <input type="text" class="form-control" placeholder="Enter number">
          </div>

          <div class="mb-3">
            <label>Name</label>
            <input type="text" class="form-control" placeholder="Enter name">
          </div>

          <button class="pay-btn">Pay ₹ 8999 →</button>

        </form>

      </div>
    </div>

  </div>
</div>

</body>
</html>