<script>
        function checkAnswer() {
          const correctAnswers = [
             152,42,68,53,8,197,9,108,15,62,124,29,85,46,186,65,114,114,16,114
          ];

          for (let i = 1; i <= 20; i++) {
            const answer = Number(document.getElementById(`answerInput${i}`).value);
            const box = document.getElementById(`questionBox${i}`);

            box.classList.remove("correct", "wrong");

            if (answer === correctAnswers[i - 1]) {
                box.classList.add("correct");
            } else {
              box.classList.add("wrong");
            }
          }
        }
</script>
